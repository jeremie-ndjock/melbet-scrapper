# Modèle de configuration : copier vers .env et renseigner les valeurs.
# Ne jamais mettre de vraies valeurs dans ce fichier.

# --- E-mail (SMTP) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_FROM=
EMAIL_TO=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_USERNAME=

# --- Base de données ---
POSTGRES_USER=collector
POSTGRES_DB=odds
POSTGRES_PASSWORD=
