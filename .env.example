# Modèle de configuration : copier vers .env et renseigner les valeurs.
# Ne jamais mettre de vraies valeurs dans ce fichier.

# --- E-mail (SMTP) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_FROM=
EMAIL_TO=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_USERNAME=
# Un salon Telegram dédié au fil de match en direct PAR LIGUE (distinct des alertes ci-dessus) :
# voir live_feed.py. Le suffixe est l'identifiant de ligue (config/leagues.yaml). Une ligue omise
# ici n'a simplement pas son fil (plusieurs ligues peuvent aussi partager le même salon si besoin :
# rien dans le code ne l'interdit, chaque valeur est indépendante).
TELEGRAM_MATCH_CHAT_ID_1252965=
TELEGRAM_MATCH_CHAT_ID_2282406=
TELEGRAM_MATCH_CHAT_ID_3066896=
TELEGRAM_MATCH_CHAT_ID_3066897=

# --- Base de données ---
POSTGRES_USER=collector
POSTGRES_DB=odds
POSTGRES_PASSWORD=

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=
